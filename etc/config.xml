<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <dmlab_customer_passkey>
            <general>
                <enabled>0</enabled>
                <user_verification>preferred</user_verification>
                <authenticator_attachment>any</authenticator_attachment>
                <timeout>60000</timeout>
                <allow_passwordless>1</allow_passwordless>
                <reauth_window>300</reauth_window>
            </general>
            <notification>
                <enabled>1</enabled>
                <identity>general</identity>
                <added_template>dmlab_customer_passkey_notification_added_template</added_template>
                <removed_template>dmlab_customer_passkey_notification_removed_template</removed_template>
            </notification>
        </dmlab_customer_passkey>
    </default>
</config>
