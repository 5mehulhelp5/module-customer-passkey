<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Back the WebAuthn library's credential-source repository with our storage,
         so the attestation/assertion validators read and write our credential table. -->
    <preference for="Webauthn\PublicKeyCredentialSourceRepository"
                type="DmLab\CustomerPasskey\Model\Webauthn\CredentialSourceRepository"/>
</config>
