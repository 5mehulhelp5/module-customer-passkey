<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Own frontend URL builder: setScope() must not leak into the shared one (or the backend one in admin). -->
    <type name="DmLab\CustomerPasskey\Model\Notification\PasskeyNotifier">
        <arguments>
            <argument name="urlBuilder" xsi:type="object" shared="false">Magento\Framework\Url</argument>
        </arguments>
    </type>
</config>
